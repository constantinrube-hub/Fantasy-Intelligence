{
  "schema": "fie-window2b-trench-research-config-v1",
  "schema_version": 1,
  "status": "IMPLEMENTED_RESEARCH_ONLY",
  "production_model": "M9",
  "research_owner": "research/window2b_trench_research.py",
  "evidence_owner": "research/window2a_trench_evidence.py",
  "default_seasons": [2019, 2020, 2021, 2022, 2023, 2024, 2025],
  "screening_target": {
    "name": "standard_ppr_player_week",
    "positions": ["QB", "RB", "WR", "TE"],
    "purpose": "cross-league incremental football-signal screening only",
    "production_scoring_replacement": false,
    "dst_target_bound": false
  },
  "baseline_features": [
    "fp_prior1",
    "fp_prior4_mean",
    "fp_season_to_date_mean",
    "prior_games"
  ],
  "candidate_families": {
    "QB": {
      "PASS_PROTECTION_FRONT_CORE": [
        "own_sack_rate_allowed",
        "opp_sack_rate_generated"
      ]
    },
    "RB": {
      "RUN_BLOCK_FRONT_CORE": [
        "own_rush_epa_per_attempt",
        "own_rush_success_rate",
        "own_stuff_rate_allowed",
        "opp_rush_epa_allowed_per_attempt",
        "opp_rush_success_rate_allowed",
        "opp_stuff_rate_forced"
      ]
    },
    "WR": {
      "PASS_PROTECTION_FRONT_CORE": [
        "own_sack_rate_allowed",
        "opp_sack_rate_generated"
      ]
    },
    "TE": {
      "PASS_PROTECTION_FRONT_CORE": [
        "own_sack_rate_allowed",
        "opp_sack_rate_generated"
      ]
    }
  },
  "optional_qb_hit_metrics": {
    "confirmatory_gate_member": false,
    "reason": "Window 2A classifies QB-hit evidence as optional rather than core"
  },
  "validation": {
    "comparison": "paired_same_complete_case_rows",
    "chronology": "train seasons strictly earlier than test season",
    "ridge_alpha": 10.0,
    "hyperparameter_tuning": false,
    "minimum_prior_player_games": 2,
    "min_total_eval_rows": 300,
    "min_test_folds": 3,
    "min_test_rows_per_fold": 25,
    "min_train_rows_per_fold": 100,
    "min_relative_mae_improvement": 0.005,
    "min_relative_rmse_improvement": 0.0,
    "min_fold_win_share": 0.6,
    "max_single_fold_mae_deterioration": 0.05,
    "bootstrap_ci_level": 0.95,
    "bootstrap_draws": 2000,
    "bootstrap_ci_lower_must_exceed_zero": true
  },
  "thin_integration": {
    "automatic_promotion": false,
    "validated_status": "RESEARCH_VALIDATED_CANDIDATE",
    "allowed_surface": "research_context_only",
    "prohibited_surfaces": [
      "production_projection",
      "canonical_ranking",
      "waiver_value",
      "runtime",
      "automatic_model_promotion"
    ]
  },
  "governance": {
    "canonical_rankings_changed": false,
    "runtime_changed": false,
    "waiver_values_changed": false,
    "adp_used_as_football_feature": false,
    "missing_trench_zero_imputation": false,
    "target_week_realised_trench_stats_allowed": false,
    "production_activation_authorized": false
  }
}
