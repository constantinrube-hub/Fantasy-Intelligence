    "metrics": {
      "point": ["mae", "rmse", "mean_bias", "spearman", "top_k_overlap"],
      "count": ["mean_poisson_deviance_when_applicable"],
      "distribution": ["pinball_loss", "weighted_interval_score_or_crps", "p10_p90_coverage", "interval_width"],
      "availability": ["expected_games_mae", "interval_coverage"],
      "coherence": ["maximum_constraint_residual", "aggregate_constraint_residual", "unallocated_share"]
    },
    "challenger_publication_gate": {
      "outer_folds": 4,
      "minimum_nonnegative_mae_folds": 3,
      "mean_paired_mae_improvement_gt": 0.0,
      "temporal_block_bootstrap_ci95_low_gt": 0.0,
      "distribution_score_noninferior": true,
      "p10_p90_coverage_target": 0.8,
      "p10_p90_coverage_absolute_tolerance": 0.05,
      "no_material_subgroup_regression": true,
      "coherence_required": true,
      "deterministic_reproduction_required": true
    },
    "baseline_only_policy": "A transparent baseline may publish only after provenance, coverage, calibration, coherence, and deterministic reproduction pass; it must remain visibly BASELINE_ONLY.",
    "artifacts": {
      "root": "data/research/evaluation/2026/preseason/general-preview-v1",
      "manifest": "manifest.json",
      "players": "player-stat-projections.csv",
      "teams": "team-stat-projections.csv",
      "validation": "validation.json",
      "report": "general-preview.md",
      "overwrite_policy": "first_write_immutable"
    }
  },
  "phase_b": {
    "input": "exact Phase A manifest and reconciled joint scenarios",
