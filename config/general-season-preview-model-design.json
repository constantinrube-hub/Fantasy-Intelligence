    "outer_folds": [
      {"train": [2019, 2020, 2021], "test": 2022},
      {"train": [2019, 2020, 2021, 2022], "test": 2023},
      {"train": [2019, 2020, 2021, 2022, 2023], "test": 2024},
      {"train": [2019, 2020, 2021, 2022, 2023, 2024], "test": 2025}
