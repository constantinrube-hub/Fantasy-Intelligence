      "IDP": "DIAGNOSTIC_ONLY_OR_TYPED_BLOCKER_IN_V1"
    },
    "reconciliation": {
      "per_joint_scenario": true,
      "before_quantiles": true,
      "before_scoring": true,
      "nonnegative": true,
      "structural_inequalities": [
        "completions_lte_passing_attempts",
        "receptions_lte_targets"
      ],
      "player_team_equalities": [
        "qb_passing_attempts_to_team_passing_attempts",
        "player_receptions_to_team_completions",
