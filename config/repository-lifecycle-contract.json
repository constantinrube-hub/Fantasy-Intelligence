{
  "schema": "fie-repository-lifecycle-v1",
  "owner": "repository-audit",
  "canonical_documents": [
    {"path": "README.md", "role": "repository entry point"},
    {"path": "CHANGELOG.md", "role": "versioned change history"},
    {"path": "docs/current/ARCHITECTURE.md", "role": "current architecture"},
