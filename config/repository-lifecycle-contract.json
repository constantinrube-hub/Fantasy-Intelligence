    {"pattern": "build-*.yml", "class": "research_or_runtime_build", "lifecycle": "active_operational"},
    {"pattern": "rebuild-*.yml", "class": "release_rebuild", "lifecycle": "active_operational"},
    {"pattern": "capture-*.yml", "class": "data_capture", "lifecycle": "active_operational"},
    {"pattern": "bulk-*.yml", "class": "portfolio_operation", "lifecycle": "active_operational"},
    {"pattern": "migrate-*.yml", "class": "migration", "lifecycle": "active_operational"},
    {"pattern": "publish-*.yml", "class": "publication", "lifecycle": "active_operational"},
    {"pattern": "repair-*.yml", "class": "repair", "lifecycle": "active_operational"},
    {"pattern": "apply-*.yml", "class": "historical_application", "lifecycle": "retained_for_provenance"}
  ],
  "controlled_audit_trigger_policy": "completed and in-progress controlled-tranche validators are workflow_dispatch-only except the new tranche preflight/target while it is being introduced",
