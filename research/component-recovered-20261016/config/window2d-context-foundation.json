{
  "schema": "fie-window2d-context-foundation-config-v1",
  "schema_version": 1,
  "status": "IMPLEMENTED_RESEARCH_ONLY",
  "production_model": "M9",
  "research_owner": "research/window2d_context_foundation.py",
  "input_families": {
    "schedule_and_game_identity": {
      "source": "nflverse nfldata games.csv",
      "status": "BOUND"
    },
    "venue": {
      "source": "nflverse schedule/weather evidence",
      "status": "DESCRIPTIVE_ONLY"
    },
    "weather": {
      "source": "Window 1A point-in-time weather evidence",
      "status": "DESCRIPTIVE_ONLY"
    },
    "rest": {
      "source": "scheduled kickoff chronology only",
      "status": "DESCRIPTIVE_ONLY"
    },
    "availability_v2": {
      "source": "Window 2C exact artifact binding",
      "status": "DESCRIPTIVE_ONLY"
    },
    "trench": {
      "source": "Window 2B thin-integration-v1 registry",
      "validated_candidates_only": true,
      "status": "RESEARCH_CONTEXT_ONLY"
    },
    "travel": {
      "status": "NOT_BOUND_V1",
      "reason": "no governed point-in-time route/neutral-site contract is assumed"
    },
    "coaching": {
      "status": "NOT_BOUND_V1",
      "reason": "no governed point-in-time coaching source is assumed"
    }
  },
  "rest_classification": {
    "short_rest_days_below": 6.5,
    "normal_rest_days_min": 6.5,
    "normal_rest_days_max": 8.5,
    "extended_rest_days_above": 8.5,
    "predictive_effect_assumed": false
  },
  "outputs": {
    "root": "data/research/context/foundation/<season>/week_<week>/<point_in_time_stamp>/",
    "context": "context-foundation-v1.json"
  },
  "governance": {
    "research_only": true,
    "allowed_surface": "research_context_only",
    "context_predictive_weights_authorized": false,
    "window2e_validation_required_before_predictive_integration": true,
    "automatic_model_promotion": false,
    "canonical_rankings_changed": false,
    "runtime_changed": false,
    "production_projections_changed": false,
    "waiver_values_changed": false,
    "adp_used_as_football_feature": false,
    "market_used_as_football_feature": false,
    "target_week_realised_stats_allowed": false,
    "missing_context_zero_imputation": false
  }
}
